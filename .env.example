# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Google Analytics 4 Measurement ID
# Get this from: https://analytics.google.com/analytics/web/
# Navigate to: Admin > Data Streams > Select your Web stream > Measurement ID
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Formspree Form ID
# Get this from: https://formspree.io/
# 1. Sign up for a free account at https://formspree.io/
# 2. Create a new form
# 3. Copy the Form ID (looks like: xyzabc123)
# Format: xyzabc123 (just the ID, not the full URL)
VITE_FORMSPREE_FORM_ID=

# ============================================
# Contact Form Webhook Notifications (Optional)
# ============================================
# Get instant notifications when someone fills out your contact form
# Configure any or all of these services

# Slack Webhook URL
# Get this from: https://api.slack.com/messaging/webhooks
# 1. Go to https://api.slack.com/apps and create a new app
# 2. Enable "Incoming Webhooks"
# 3. Create a webhook for your desired channel
# 4. Copy the webhook URL
VITE_SLACK_WEBHOOK_URL=
VITE_SLACK_CHANNEL=#contact-forms

# Discord Webhook URL
# Get this from Discord Server Settings
# 1. Open Server Settings > Integrations > Webhooks
# 2. Create a new webhook
# 3. Select the channel for notifications
# 4. Copy the webhook URL
VITE_DISCORD_WEBHOOK_URL=

# Telegram Bot Notifications
# Get these from: https://t.me/BotFather
# 1. Chat with @BotFather on Telegram
# 2. Create a new bot with /newbot command
# 3. Copy the bot token
# 4. Get your chat ID from @userinfobot
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Email API Endpoint (Custom implementation)
VITE_EMAIL_API_ENDPOINT=

# ============================================
# Firebase Configuration
# ============================================
# Get these from: https://console.firebase.google.com/
# 1. Go to Project Settings > General
# 2. Scroll to "Your apps" and select the web app
# 3. Copy the config values

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to 'true' to use Firestore emulator in development
VITE_FIREBASE_USE_EMULATOR=
